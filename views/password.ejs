<%- include('partials/app-open') %>
<div class="panel narrow">
  <h1>Cambiar contraseña</h1>
  <p class="lead">Al cambiarla, todos tus dispositivos de confianza volverán a pedir el segundo factor.</p>
  <% if (errors.length) { %>
  <div class="alert alert-error mt-md" role="alert"><%- include('partials/icon', { name: 'alert' }) %><div><b>Revisa estos puntos:</b><ul><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div></div>
  <% } %>
  <form method="post" action="/cuenta/contrasena" class="mt-lg" data-loading novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field">
      <label for="current_password">Contraseña actual</label>
      <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
    </div>
    <div class="field">
      <label for="password">Nueva contraseña</label>
      <div class="pw-wrap">
        <input id="password" name="password" type="password" autocomplete="new-password" required data-strength>
        <button type="button" class="pw-toggle" data-toggle-pw="password" aria-label="Mostrar contraseña">Mostrar</button>
      </div>
      <div class="meter" data-meter data-score="0"><i></i></div>
      <div class="meter-label" data-meter-label aria-live="polite"></div>
      <ul class="rules">
        <li data-rule="len">10 caracteres o más</li>
        <li data-rule="case">Mayúsculas y minúsculas</li>
        <li data-rule="num">Al menos un número</li>
        <li data-rule="sym">Al menos un símbolo</li>
      </ul>
    </div>
    <div class="field">
      <label for="password2">Repite la nueva contraseña</label>
      <input id="password2" name="password2" type="password" autocomplete="new-password" required data-match="password">
      <span class="hint" data-match-msg aria-live="polite"></span>
    </div>
    <div class="actions mt-md"><button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span>Guardar contraseña</button></div>
  </form>
</div>
<%- include('partials/app-close') %>
