<%- include('partials/head') %>
<body>
<main class="page narrow error-page">
  <a class="brand brand-dark" href="/"><%- include('partials/brand') %><span><%= appName %></span></a>
  <p class="error-code mt-lg"><%= code %></p>
  <h1><%= title %></h1>
  <p class="lead"><%= message %></p>
  <div class="row mt-lg">
    <a class="btn btn-primary" href="<%= locals.user ? '/panel' : '/login' %>"><%= locals.user ? 'Ir a mi cuenta' : 'Ir al inicio de sesión' %></a>
  </div>
</main>
</body>
</html>
