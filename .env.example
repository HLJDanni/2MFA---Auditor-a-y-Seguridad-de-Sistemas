# Copia este archivo como .env y ajusta los valores. Todo es opcional para la demostración.

# --- General ---
PORT=3000
APP_NAME=Ceiba
# En modo demo se crean usuarios de prueba y existe la bandeja /demo/bandeja. En producción: false
DEMO_MODE=true
BASE_URL=http://localhost:3000

# --- Secretos (en producción defínelos; si se omiten, se generan y guardan en data/) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
# true solo si sirves la aplicación por HTTPS
SECURE_COOKIES=false

# --- Políticas de seguridad ---
BCRYPT_ROUNDS=12
MAX_PASSWORD_ATTEMPTS=5
LOCK_MINUTES=15
MAX_MFA_ATTEMPTS=5
MAX_MFA_FAILURES_LOCK=10
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
SESSION_IDLE_MINUTES=30
TRUSTED_DEVICE_DAYS=30
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW=15
CHECK_PWNED_PASSWORDS=true

# --- Correo real (opcional). Ejemplo con Gmail y una "contraseña de aplicación" ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ceiba Seguridad <tu-correo@gmail.com>

# --- SMS real con Twilio (opcional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
